# ===============================================
# Variáveis de Ambiente — Rota Vital (PI 2026.2)
# Copie este arquivo para .env e ajuste os valores
# ===============================================

# Banco de Dados PostgreSQL
POSTGRES_DB=rotavital
POSTGRES_USER=rotavital_user
POSTGRES_PASSWORD=altere_esta_senha_localmente
DB_PORT=5432

# Servidor API Spring Boot
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# ===============================================
# Observabilidade
# ===============================================

# Grafana (R5.2: a senha padrão admin/admin é proibida pelo enunciado).
# O compose FALHA de propósito se GRAFANA_ADMIN_PASSWORD não estiver definida.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=altere_esta_senha_localmente
GRAFANA_PORT=3000

