    {
      "id": 21,
      "type": "timeseries",
      "title": "Pausas de GC",
      "description": "Durante a pausa de GC a aplicacao congela. Sem buckets de histograma para jvm.gc.pause, usa-se media (sum/count) e o maximo exposto pelo proprio Micrometer, em vez de histogram_quantile.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(jvm_gc_pause_seconds_sum{job=\"rotavital-api\"}[5m])) by (action)",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "tempo em GC - {{action}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(jvm_gc_pause_seconds_sum{job=\"rotavital-api\"}[5m])) / sum(rate(jvm_gc_pause_seconds_count{job=\"rotavital-api\"}[5m]))",
          "refId": "B",
          "range": true,
          "instant": false,
          "legendFormat": "duracao media da pausa"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max(jvm_gc_pause_seconds_max{job=\"rotavital-api\"})",
          "refId": "C",
          "range": true,
          "instant": false,
          "legendFormat": "pausa maxima"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
