    {
      "id": 20,
      "type": "timeseries",
      "title": "Heap: usado x comprometido x maximo",
      "description": "Serra = GC saudavel. Usado colado no maximo = risco de OutOfMemoryError.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
