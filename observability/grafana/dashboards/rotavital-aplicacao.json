          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=\"rotavital-api\"}[5m])) by (le, uri))",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "{{uri}}"
