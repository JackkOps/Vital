{
  "uid": "rotavital-logs",
  "title": "Rota Vital - Logs & Traces",
  "description": "Logs centralizados no Loki, coletados pelo Grafana Alloy. Requisitos R6.1 e (apos a F7) R6.3.",
  "tags": [
    "rotavital",
    "logs",
    "loki"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "graphTooltip": 1,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Volume de logs por servico",
      "description": "count_over_time conta linhas de log na janela. Equivalente do rate() no LogQL. O label 'service' vem do nome do servico no compose, atribuido pelo Alloy.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum by (service) (count_over_time({stack=\"rotavital\"}[1m]))",
          "refId": "A",
          "queryType": "range",
          "range": true,
          "instant": false,
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 25,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Volume de logs por nivel",
      "description": "O nivel e extraido da linha por expressao regular no pipeline do Alloy (stage.regex + stage.labels).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum by (level) (count_over_time({stack=\"rotavital\"}[1m]))",
          "refId": "A",
          "queryType": "range",
          "range": true,
          "instant": false,
          "legendFormat": "{{level}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 25,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "logs",
      "title": "Logs da aplicacao Java (api)",
      "description": "LogQL: {service=\"api\"}. O seletor de stream entre chaves e obrigatorio e sempre vem primeiro — e o equivalente do seletor de metrica no PromQL.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 11
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{service=\"api\"}",
          "refId": "A",
          "queryType": "range",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "id": 11,
      "type": "logs",
      "title": "Somente erros e avisos (todos os servicos)",
      "description": "Filtro por label (rapido, usa indice). Alternativa por conteudo seria {stack=\"rotavital\"} |= \"ERROR\", que varre o texto e e mais lenta.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{stack=\"rotavital\", level=~\"ERROR|WARN\"}",
          "refId": "A",
          "queryType": "range",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "id": 12,
      "type": "logs",
      "title": "Logs do banco de dados (Postgres)",
      "description": "Demonstra que o Alloy coleta de TODOS os conteineres, nao apenas da aplicacao Java — vantagem sobre um appender dentro da app.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{service=\"db\"}",
          "refId": "A",
          "queryType": "range",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Taxa de erro de log x total",
      "description": "Proporcao de linhas de ERROR sobre o total. Mesma ideia da taxa de erro HTTP, mas medida pelos logs.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({stack=\"rotavital\", level=\"ERROR\"}[5m])) / sum(count_over_time({stack=\"rotavital\"}[5m]))",
          "refId": "A",
          "queryType": "range",
          "range": true,
          "instant": false,
          "legendFormat": "proporcao de ERROR"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 25,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}